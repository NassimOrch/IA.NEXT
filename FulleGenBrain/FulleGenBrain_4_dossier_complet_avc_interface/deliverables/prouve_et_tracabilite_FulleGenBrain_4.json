  "claims": [
    {
      "id": "FGB4-001",
      "claim": "FulleGenBrain_4 does not depend on an LLM/eLLM for runtime generation or knowledge.",
      "status": "ARCHITECTURAL_REQUIREMENT",
      "evidence": "architecture abstract and no-neural-language-model section"
    },
    {
      "id": "FGB4-002",
      "claim": "The original ASCR subsection from the V3 architecture source is textually unchanged in the V4 architecture; ASCRC is introduced as a separate controller.",
      "status": "TEXTUAL_NON_INTERFERENCE_CHECKED",
      "scope": "This proves non-modification of the cited ASCR definition in the architecture text; it is not a proof of binary compatibility with every external eGenBrain v4 build.",
      "evidence": "SHA-256 of extracted subsection body matches exact V3 source; ASCRC integration section"
    },
    {
      "id": "FGB4-003",
      "claim": "All 29 composition AST constructors retained from theory v1 are present in the theory and in the FulleGenBrain_4 integration matrix; ASCRC is a cross-cutting mechanism, not an AST constructor.",
      "status": "MECHANICALLY_CHECKED",
      "scope": "specification coverage, not full runtime implementation",
      "evidence": "grammar and operator integration matrix"
    },
    {
      "id": "FGB4-004",
      "claim": "ASCRC separates candidate existence, epistemic status, lifecycle, eligibility, activation and execution. Activation/hibernation alone does not change epistemic status.",
      "status": "SPECIFIED_AND_LOCALLY_TESTED",
      "scope": "reference prototype and stated contract",
      "evidence": "ASCRC section; tests/test_ascrc_controller.py"
    },
    {
      "id": "FGB4-005",
      "claim": "ASCRC does not replace hard resource budgets: it allocates under them and preserves exploration, verification and maintenance shares where policy requires.",
      "status": "SPECIFIED_AND_LOCALLY_TESTED",
      "scope": "scalar budget in prototype; vector resource accounting remains a production contract",
      "evidence": "ASCRC allocation contract and tests"
    },
    {
      "id": "FGB4-006",
      "claim": "The local ASCRC prototype provides reversible dormancy/wake requests, hard-budget selection, freshness gates, protection for pins/leases/transactions, age-based service and audit events.",
      "status": "LOCAL_TEST_PASS",
      "scope": "15 prototype tests; not a full FulleGenBrain runtime",
      "evidence": "reference_impl/ascrc_controller.py and tests/test_ascrc_controller.py"
    },
    {
      "id": "FGB4-007",
      "claim": "The model-of-world remains conditional on pre-registered paired empirical decision utility rather than mandatory by design.",
      "status": "ARCHITECTURAL_DECISION_FROM_HISTORICAL_EVIDENCE",
      "scope": "O62/O63 values are historical report values and were not rerun in this release",
      "evidence": "sources/evidence/order62_order63_review_extract.md"
    },
    {
      "id": "FGB4-008",
      "claim": "The current delivered test suite passes 46 tests and Python compileall succeeds.",
      "status": "LOCAL_TEST_PASS",
      "scope": "local unit tests only; does not establish end-to-end system capability",
      "evidence": "validation/pytest_v4.txt and reproduction logs"
    },
    {
      "id": "FGB4-009",
      "claim": "The two PDFs compile reproducibly in two pdflatex passes and their rendered pages were inspected.",
      "status": "BUILD_AND_VISUAL_CHECK",
      "scope": "PDF build/layout only",
      "evidence": "build logs, pdfinfo and renders"
    },
    {
      "id": "FGB4-010",
      "claim": "The complete FulleGenBrain_4 runtime has not been evaluated end-to-end in this release.",
      "status": "NOT_EVALUATED",
      "scope": "does not predict the future result",
      "evidence": "architecture status declarations"
    },
    {
      "id": "FGB4-011",
      "claim": "A comprehensive UX/UI specification exists for the full intended FulleGenBrain_4 interface, including chat, model/dataset/training management, optional LLM/RAG, observation, cloning, composition, memory, ASCRC, evaluations, security and audit.",
      "status": "SPECIFICATION_COMPILED_AND_VISUALLY_REVIEWED",
      "scope": "design specification only; does not assert that the graphical application or all backing services are implemented",
      "evidence": "interface_FulleGenBrain_4.tex, deliverables/interface_FulleGenBrain_4.pdf, UI-01 through UI-20 acceptance criteria"
    }
